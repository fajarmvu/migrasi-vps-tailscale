# Template unit systemd untuk model router / backend API (mesin TUJUAN).
# Ganti <USER>, <APP_DIR>, <PORT>. Router hanya listen di 127.0.0.1;
# akses publik HANYA melalui tunnel.
[Unit]
Description=Model router (OpenAI-compatible, localhost only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<USER>
WorkingDirectory=<APP_DIR>
ExecStart=<APP_DIR>/run-router.sh --host 127.0.0.1 --port <PORT>
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
