# Salin berkas ini menjadi config.env lalu isi nilai aslinya.
#   cp config.env.example config.env
# JANGAN commit config.env ke Git (sudah masuk .gitignore).

# Nama dan IP Tailscale kedua mesin (lihat dari `tailscale status`)
TS_NAME_MUSE=vm-muse
TS_IP_MUSE=100.x.x.x
TS_NAME_CUE=vps-cue
TS_IP_CUE=100.x.x.x

# User Linux di mesin tujuan untuk menerima migrasi via SSH
SSH_USER_CUE=deploy

# Kunci SSH khusus migrasi (dibuat oleh scripts/gen-migration-key.sh)
SSH_KEY=$HOME/.ssh/migrasi_ed25519
